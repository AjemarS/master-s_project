PORT=8003
NODE_ENV=development

# Database
NOTIFICATIONS_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/notifications_db

# Auth service (internal API — replaces direct DB reads)
AUTH_SERVICE_URL=http://auth-service:3001

# RabbitMQ
RABBITMQ_URL=amqp://CHANGE_ME:CHANGE_ME@rabbitmq:5672

# Resend (transactional email)
RESEND_API_KEY=CHANGE_ME
RESEND_FROM_EMAIL=onboarding@resend.dev

# Admin email for low-stock alerts
ADMIN_EMAIL=

# Logging
LOG_LEVEL=info
