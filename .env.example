# TechHub Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL Databases
POSTGRES_DB=products_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DB_HOST=products_db
DB_PORT=5432

AUTH_DB_NAME=auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=changeme
AUTH_PORT=3001

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=postgres
INVENTORY_DB_PASSWORD=changeme

ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=postgres
ORDERS_DB_PASSWORD=changeme

NOTIFICATIONS_DB_NAME=notifications_db
NOTIFICATIONS_DB_USER=postgres
NOTIFICATIONS_DB_PASSWORD=changeme

# Django
DJANGO_SECRET_KEY=changeme-to-a-secure-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,product-service,inventory-service,order-service,gateway,frontend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000

INVENTORY_DJANGO_SECRET_KEY=changeme-to-a-secure-random-string
ORDERS_DJANGO_SECRET_KEY=changeme-to-a-secure-random-string

# Service URLs
PRODUCT_SERVICE_URL=http://product-service:8000
FRONTEND_SERVICE_URL=http://frontend:3000
AUTH_SERVICE_URL=http://auth-service:3001
INVENTORY_SERVICE_URL=http://inventory-service:8001
ORDER_SERVICE_URL=http://order-service:8002
NOTIFICATION_SERVICE_URL=http://notification-service:8003
API_SERVICE_URL=http://gateway:8080/api
CORS_ORIGINS=http://localhost,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Auth (Better Auth)
BETTER_AUTH_SECRET=changeme-to-a-secure-random-string
BETTER_AUTH_URL=http://localhost:3001/auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3001/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:3001/auth/callback/github

# RabbitMQ
RABBITMQ_USER=techhub
RABBITMQ_PASSWORD=changeme
RABBITMQ_URL=amqp://techhub:changeme@rabbitmq:5672/

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_AUTH_URL=http://localhost/auth
PROXY_AUTH_URL=http://gateway:8080/auth
NODE_ENV=development

# Stripe (optional — leave blank to disable payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications (optional — leave blank to disable)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@techhub.shop
NOTIFICATIONS_DATABASE_URL=postgresql://postgres:changeme@notifications_db:5432/notifications_db
AUTH_DATABASE_URL=postgresql://postgres:changeme@auth_db:5432/auth_db
