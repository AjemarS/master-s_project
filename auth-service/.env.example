# Database
DATABASE_URL=postgresql://postgres:postgres@auth_db:5432/auth_db

# Frontend URL (CORS origin)
FRONTEND_URL=http://localhost:3000

# Admin user IDs (comma-separated). Populated automatically on first startup
# when ADMIN_EMAIL/ADMIN_PASSWORD are set. Copy the logged ID here for persistence.
ADMIN_USER_IDS=CHANGE_ME

# Seed admin user on first startup (used only when ADMIN_USER_IDS is empty)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Better Auth secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=CHANGE_ME

# Better Auth base URL (public gateway URL so email links are reachable)
BETTER_AUTH_URL=http://localhost/auth

# Google OAuth — redirect URI (code reads GOOGLE_REDIRECT_URL)
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URL=http://localhost:3001/auth/callback/google

# GitHub OAuth — redirect URI (code reads GITHUB_REDIRECT_URL)
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_REDIRECT_URL=http://localhost:3001/auth/callback/github

# Redis (for rate limiting)
REDIS_URL=redis://redis:6379

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@techhub.shop

# Server
PORT=3001

# Logging
LOG_LEVEL=debug
